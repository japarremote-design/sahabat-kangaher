{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahabat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // hanya halaman utama yang lewat worker (untuk redirect workers.dev);
    // CSS, JS, gambar tetap dilayani langsung sebagai aset statis
    "run_worker_first": ["/", "/index.html"]
  }
}
